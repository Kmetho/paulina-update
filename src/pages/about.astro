---
import Layout from "../layouts/Layout.astro";
import SocialIcons from "../components/SocialIcons.astro";
---

<Layout
  title="Paulina Rams | graphic designer | visual artist  ◕‿◕｡"
  bodyClass="about-bg"
>
  <img class="png pr" src="/images/about/PR.png" alt="Metallic initials." />

  <div class="aboutpage container">
    <div class="box name-box">
      <h1 class="first">PAULINA</h1>
      <h1 class="last">RAMS</h1>
      <img
        class="smol"
        src="/images/home/photo smol.png"
        alt="A very small photo of Paulina."
      />
      <div class="whoareyou">
        <p>visual mixed media/ graphic design/</p>
        <p>illustrations/ layouts/ branding/</p>
        <p>ui/ux/ sound design / mapping/</p>
        <p>vjing/ motion design/ interface</p>
      </div>
    </div>

    <div class="box work-box">
      <a
        href="https://www.figma.com/proto/IDiu9gWKBNDh9FXewjC1LY/folio?page-id=0%3A1&node-id=12%3A11&viewport=392%2C592%2C0.03&scaling=contain"
        target="_blank"
      >
        <p class="work-click">work</p>
      </a>
    </div>

    <div class="box text-box">
      <div class="mail">
        <p>I will be happy to create something together ☻</p>
        <p>Feel free to get in touch at:</p>
        <p><a href="mailto:pavlinarams@gmail.com">pavlinarams@gmail.com</a></p>
      </div>
      <div class="exp">
        <p>EXPERIENCE</p>
        <p>in work with</p>
        <p>
          <a href="https://www.kommunikat.pl/" target="_blank">Kommunikat</a>,
          <a href="https://nonoproblemo.pl/" target="_blank"> Nonoproblemo</a>,
          <a href="https://www.semiotikdesign.com/" target="_blank">
            Semiotik Design</a
          >,
          <a href="https://navarra.is/en/" target="_blank"> Navarra.is</a>,
          <a href="https://flokdesign.com/" target="_blank"> Flok</a>,
          <a href="https://neeeu.io/" target="_blank"> Neeeu</a>
        </p>
      </div>
      <div class="edu">
        <p>EDUCATION</p>
        <p>University of Art Poznan</p>
        <p>BA Graphic Design</p>
      </div>
      <div class="place">
        <p>Berlin based freelancer</p>
      </div>
    </div>

    <div class="box about-box">
      <a href="/">
        <p class="click about-click"><em>return</em></p>
      </a>
    </div>

    <SocialIcons />
  </div>
</Layout>
